# ============================================================
# Jordan Legal KG API — FINAL model-comparison configuration
# ============================================================

APP_NAME=Jordan Legal KG API
APP_VERSION=0.1.0
APP_ENVIRONMENT=development

# Final benchmark runs must fail closed on any LLM-stage execution failure.
PIPELINE_STRICT_EVALUATION=true

# ============================================================
# EVALUATED MODEL — CHANGE ONLY THESE TWO BETWEEN MODELS
# ============================================================

# GPT example
PIPELINE_LLM_PROVIDER=openai
PIPELINE_LLM_MODEL=gpt-5-nano

# Gemini example (current GA stable model as of 2026-08)
# PIPELINE_LLM_PROVIDER=google
# PIPELINE_LLM_MODEL=gemini-3.6-flash

# Qwen 8B via host Ollama
# PIPELINE_LLM_PROVIDER=ollama
# PIPELINE_LLM_MODEL=qwen3:8b

# Aya 8B via host Ollama — choose ONE exact model before final freeze
# PIPELINE_LLM_PROVIDER=ollama
# PIPELINE_LLM_MODEL=aya:8b
# or newer multilingual Aya Expanse:
# PIPELINE_LLM_MODEL=aya-expanse:8b

# ============================================================
# PIPELINE STAGES — FIXED FOR EVERY MODEL
# ============================================================

PIPELINE_QUERY_PLANNER_ENABLED=true
PIPELINE_RERANK_ENABLED=true
PIPELINE_ANSWER_ENABLED=true

PIPELINE_QUERY_PLANNER_ROUTE_CONFIDENCE=0.80
PIPELINE_QUERY_PLANNER_RETRIEVE_OVERRIDE_CONFIDENCE=0.90
PIPELINE_QUERY_PLANNER_VERIFY_NON_ANSWER=true
PIPELINE_QUERY_PLANNER_NON_ANSWER_VERIFY_CONFIDENCE=0.80
PIPELINE_QUERY_PLANNER_VERIFY_LOW_CONFIDENCE_RETRIEVE=false
PIPELINE_QUERY_PLANNER_RETRIEVE_VERIFY_BELOW=0.90

# Fixed output budgets. Provider adapter permits exactly one larger retry only
# when the first structured response hits its output-token ceiling.
PLANNER_MAX_OUTPUT_TOKENS=3000
RERANKER_MAX_OUTPUT_TOKENS=2000
GENERATOR_MAX_OUTPUT_TOKENS=3000

# Common reranker input budget so local 8K-context models and hosted models
# receive the same bounded candidate problem.
PIPELINE_RERANK_ARTICLE_CHAR_LIMIT=2500
RERANKER_CANDIDATE_LIMIT=12
RERANKER_TOTAL_CHAR_BUDGET=12000

# ============================================================
# OPENAI — always required for embeddings + fixed judge
# ============================================================

OPENAI_API_KEY=REPLACE_ME
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_REASONING_EFFORT=low
OPENAI_TIMEOUT_SECONDS=120
OPENAI_MAX_RETRIES=3
EMBEDDING_BATCH_SIZE=32

# ============================================================
# GOOGLE GEMINI — required only for PIPELINE_LLM_PROVIDER=google
# ============================================================

GOOGLE_API_KEY=REPLACE_ME_IF_USED
GOOGLE_TIMEOUT_SECONDS=120

# ============================================================
# ANTHROPIC — kept only for compatibility; not needed for current experiment
# ============================================================

ANTHROPIC_API_KEY=
ANTHROPIC_TIMEOUT_SECONDS=120
ANTHROPIC_MAX_RETRIES=3

# ============================================================
# OLLAMA — Qwen/Aya run locally on the host
# ============================================================

OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_TIMEOUT_SECONDS=600
# Common local-model context ceiling; Aya Ollama 8B tag exposes 8K.
OLLAMA_NUM_CTX=8192

# ============================================================
# FIXED EVALUATION JUDGE
# ============================================================

EVALUATION_JUDGE_MODEL=gpt-5.4-mini

# ============================================================
# WEAVIATE
# ============================================================

WEAVIATE_API_KEY=REPLACE_ME
WEAVIATE_HTTP_HOST=weaviate
WEAVIATE_HTTP_PORT=8080
WEAVIATE_GRPC_HOST=weaviate
WEAVIATE_GRPC_PORT=50051
WEAVIATE_CONNECTION_ATTEMPTS=30
WEAVIATE_CONNECTION_DELAY_SECONDS=2
WEAVIATE_NODE_BATCH_SIZE=25
WEAVIATE_EDGE_BATCH_SIZE=100
WEAVIATE_NODE_COLLECTION=JordanLaborLegalNode
WEAVIATE_EDGE_COLLECTION=JordanLaborLegalEdge

# ============================================================
# RETRIEVAL — NEVER CHANGE BETWEEN COMPARED MODELS
# ============================================================

RETRIEVAL_VECTOR_CANDIDATES=40
RETRIEVAL_BM25_CANDIDATES=40
RETRIEVAL_CONCEPT_TOP_K=12
RETRIEVAL_ARTICLE_TOP_K=5
RETRIEVAL_RRF_K=60
RETRIEVAL_PARAGRAPH_CANDIDATES=20
RETRIEVAL_GRAPH_SEED_COUNT=3
RETRIEVAL_GRAPH_MAX_HOPS=2
RETRIEVAL_GRAPH_EDGES_LIMIT=1000
RETRIEVAL_GRAPH_PATHS_PER_ARTICLE=5
RETRIEVAL_VECTOR_WEIGHT=2.0
RETRIEVAL_BM25_WEIGHT=0.7

KG_TTL_PATH=/app/data/jordan_labor_law_full_knowledge_graph.ttl

# ============================================================
# LEGACY SETTINGS — retained only for compatibility with older code paths
# Evaluated planner/reranker/generator use PIPELINE_LLM_PROVIDER/MODEL above.
# ============================================================

OPENAI_CHAT_MODEL=gpt-5-nano
OPENAI_RERANK_ENABLED=true
OPENAI_RERANK_MODEL=gpt-5-nano
OPENAI_RERANK_REASONING_EFFORT=low
OPENAI_RERANK_ARTICLE_CHAR_LIMIT=2500
OPENAI_QUERY_PLANNER_ENABLED=true
OPENAI_QUERY_PLANNER_MODEL=gpt-5-nano
OPENAI_QUERY_PLANNER_REASONING_EFFORT=low
OPENAI_QUERY_PLANNER_ROUTE_CONFIDENCE=0.80
OPENAI_QUERY_PLANNER_RETRIEVE_OVERRIDE_CONFIDENCE=0.90
OPENAI_QUERY_PLANNER_VERIFY_NON_ANSWER=true
OPENAI_QUERY_PLANNER_NON_ANSWER_VERIFY_CONFIDENCE=0.80
OPENAI_QUERY_PLANNER_VERIFY_LOW_CONFIDENCE_RETRIEVE=false
OPENAI_QUERY_PLANNER_RETRIEVE_VERIFY_BELOW=0.90
OPENAI_ANSWER_ENABLED=true
OPENAI_ANSWER_MODEL=gpt-5-nano
OPENAI_ANSWER_REASONING_EFFORT=low
OPENAI_ANSWER_ARTICLE_CHAR_LIMIT=3000
OPENAI_ANSWER_EVIDENCE_SELECTION_ENABLED=true
OPENAI_ANSWER_SELECTION_MODEL=gpt-5-nano
OPENAI_ANSWER_SELECTION_REASONING_EFFORT=low
OPENAI_ANSWER_MAX_SELECTED_ARTICLES=4
OPENAI_ANSWER_MAX_OUTPUT_TOKENS=1800
OPENAI_ANSWER_VERBOSITY=low
OPENAI_ANSWER_TIMEOUT_SECONDS=120
OPENAI_ANSWER_MAX_RETRIES=2
