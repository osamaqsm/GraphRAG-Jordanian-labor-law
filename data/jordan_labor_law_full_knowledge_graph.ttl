########## Domain Relations ##########

:worker_concept :hasRight :wage_right_concept ;
    :hasRight :leave_right_concept ;
    :hasRight :sick_leave_right_concept ;
    :hasRight :weekly_rest_right_concept ;
    :hasRight :safe_work_environment_right_concept ;
    :hasRight :litigation_right_concept ;
    :hasRight :social_security_related_right_concept ;
    :hasRight :end_of_service_benefit_right_concept ;
    :hasObligation :perform_work_obligation ;
    :hasObligation :preserve_confidentiality_obligation ;
    :hasObligation :follow_lawful_instructions_obligation ;
    :isPartyTo :employment_contract_concept .

:employer_concept :hasObligation :pay_wages_obligation ;
    :hasObligation :provide_safe_work_environment_obligation ;
    :hasObligation :assign_agreed_work_obligation ;
    :isPartyTo :employment_contract_concept .

:employment_contract_concept :hasEmployer :employer_concept ;
    :hasWorker :worker_concept .

:wage_delay_violation :breachesObligation :pay_wages_obligation ;
    :violatesRight :wage_right_concept ;
    :committedBy :employer_concept ;
    :sufferedBy :worker_concept ;
    :hasCondition :delay_exceeds_seven_days_condition ;
    :basedOnEvent :wage_payment_event ;
    :resultsIn :legal_claim_consequence ;
    :resultsIn :employer_liability_consequence .

:arbitrary_dismissal_violation :committedBy :employer_concept ;
    :sufferedBy :worker_concept ;
    :hasCondition :dismissal_without_lawful_ground_condition ;
    :basedOnEvent :dismissal_event ;
    :resultsIn :compensation_consequence ;
    :resultsIn :legal_claim_consequence .

:assignment_different_work_violation :breachesObligation :assign_agreed_work_obligation ;
    :committedBy :employer_concept ;
    :sufferedBy :worker_concept .

:disclosure_employer_secrets_violation :breachesObligation :preserve_confidentiality_obligation ;
    :committedBy :worker_concept ;
    :sufferedBy :employer_concept ;
    :resultsIn :disciplinary_action_consequence .

:work_negligence_violation :breachesObligation :perform_work_obligation ;
    :breachesObligation :follow_lawful_instructions_obligation ;
    :committedBy :worker_concept ;
    :sufferedBy :employer_concept ;
    :resultsIn :disciplinary_action_consequence .

:end_of_service_benefit_right_concept :resultsIn :end_of_service_benefit_consequence .

:work_injury_event :resultsIn :compensation_consequence ;
    :resultsIn :employer_liability_consequence .

########## Articles ##########

:article_1 rdf:type :Article ;
    rdfs:label "المادة 1"@ar ;
    rdfs:comment "يسمى هذا القانون (قانون العمل لسنة 1996) ويعمل به بعد مرور ستين يوما على تاريخ نشره في الجريدة الرسمية."@ar ;
    :hasParagraph :article_1_paragraph_1 .

:article_2 rdf:type :Article ;
    rdfs:label "المادة 2"@ar ;
    rdfs:comment "يكون للكلمات والعبارات التالية حيثما وردت في هذا القانون المعاني المخصصة لها ادناه ما لم تدل القرينة على غير ذلك:\n\nالوزارة                   : وزارة العمل.\n\nالوزير                    : وزير العمل.\n\nالامين العام               : الامين العام للوزارة.\n\nصاحب العمل              : كل شخص طبيعي او معنوي يستخدم باي صفة كانت شخصاً او اكثر مقابل اجر.\n\nنقابة اصحاب العمل       : الهيئة التي تمثل اصحاب العمل.\n\nالعامل                     : كل شخص ذكراً كان او انثى يؤدي عملاً لقاء اجر ويكون تابعاً لصاحب العمل وتحت امرته\n\n                             ويشمل ذلك الاحداث ومن كان قيد التجربة او التاهيل.\n\nالعمل                     : كل جهد فكري او جسماني يبذله العامل لقاء اجر سواء كان بشكل دائم او عرضي او مؤقت او\n\n                             موسمي.\n\nالعمل العرضي           : العمل الذي تستدعيه ضرورات طارئة ولا تزيد مدة انجازه على ثلاثة اشهر.\n\nالعمل المؤقت             : العمل الذي تقتضي طبيعة انجازه مدة محدودة.\n\nالعمل الموسمي           : العمل في مواسم محدودة من كل سنة ولا تزيد مدته على ستة اشهر.\n\nعقد العمل الجماعي       : اتفاق خطي تنظم بمقتضاه شروط العمل بين صاحب العمل او نقابة اصحاب العمل من جهة\n\n                              ومجموعة عمال او النقابة من جهة اخرى.\n\nعقد العمل                : اتفاق شفهي او كتابي صريح او ضمني يتعهد العامل بمقتضاه ان يعمل لدى صاحب العمل وتحت\n\n                            اشرافه او ادارته مقابل اجر ويكون عقد العمل لمدة محدودة او غير محدودة او لعمل معين او غير\n\n                             معين.\n\nالاجر                     : كل ما يستحقه العامل لقاء عمله نقدا او عيناً مضافاً اليه سائر الاستحقاقات الاخرى ايا كان نوعها\n\n                             اذا نص القانون او عقد العمل او النظام الداخلي او استقر التعامل على دفعها باستثناء الاجور\n\n                             المستحقة عن العمل الاضافي.\n\nالحدث                    : كل شخص ذكراً كان او انثى بلغ السابعة من عمره ولم يتم الثامنة عشرة.\n\nالمؤسسة                 : الجهة التي تقدم خدمات او تعمل في انتاج السلع او توزيعها.\n\nالمرجع الطبي            : الطبيب المعتمد او اللجنة الطبية المعتمدة من الوزير.\n\nالمرض المهني           : الاصابة باحد الامراض الصناعية المبينة في الجدول رقم (1) او الاصابة باي من الاصابات\n\n                              المهنية المبينة في الجدول رقم (2) الملحقين بهذا القانون.\n\nاصابة العمل              : اصابة العامل نتيجة حادث اثناء تادية العمل او بسببه ويعتبر في حكم ذلك الحادث ما يقع للعامل\n\n                             اثناء ذهابه لمباشرة عمله او عودته منه.\n\nالمستحق                 : المنتفع او المنتفعون من عائلة العامل المنصوص عليهم في قانون الضمان الاجتماعي المعمول\n\n                              به.\n\nالنقابة                    : تنظيم مهني عمالي يشكل وفق احكام هذا القانون.\n\nالهيئة الادارية           : الهيئة الادارية للنقابة.\n\nالنزاع العمالي الجماعي : كل خلاف ينشا بين مجموعة من العمال او النقابة من جهة وبين صاحب عمل او نقابة اصحاب\n\n                            العمل من جهة اخرى حول تطبيق عقد عمل جماعي او تفسيره او يتعلق بظروف العمل وشروطه."@ar ;
    :hasParagraph :article_2_paragraph_1 ;
    :hasDefinition :article_2_definition_1 ;
    :hasDefinition :article_2_definition_2 ;
    :hasDefinition :article_2_definition_3 ;
