@prefix : <http://example.org/jordan-labor-law#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/jordan-labor-law> rdf:type owl:Ontology ;
    rdfs:label "Jordanian Labor Law Two-Layer Ontology"@en , "أنطولوجيا قانون العمل الأردني ذات الطبقتين"@ar ;
    rdfs:comment "A two-layer ontology for Jordanian labor law: a legal-source layer and a semantic legal-concept layer containing labor-domain and statutory concepts, with explicit evidence bridges between them."@en ,
                 "أنطولوجيا من طبقتين لقانون العمل الأردني: طبقة المصدر القانوني وطبقة المفاهيم القانونية الدلالية التي تشمل مفاهيم مجال العمل والمفاهيم التشريعية، مع علاقات استدلال وربط صريحة بينهما."@ar .

########## Classes ##########

:LegalSource rdf:type owl:Class ;
    rdfs:label "Legal Source"@en , "مصدر قانوني"@ar .

:Law rdf:type owl:Class ;
    rdfs:subClassOf :LegalSource ;
    rdfs:label "Law"@en , "قانون"@ar .

:Article rdf:type owl:Class ;
    rdfs:subClassOf :LegalSource ;
    rdfs:label "Article"@en , "مادة"@ar .

:Paragraph rdf:type owl:Class ;
    rdfs:subClassOf :LegalSource ;
    rdfs:label "Paragraph"@en , "فقرة"@ar .

:Definition rdf:type owl:Class ;
    rdfs:subClassOf :LegalSource ;
    rdfs:label "Definition"@en , "تعريف"@ar .

:Amendment rdf:type owl:Class ;
    rdfs:subClassOf :LegalSource ;
    rdfs:label "Amendment"@en , "تعديل"@ar .

:LaborDomainConcept rdf:type owl:Class ;
    rdfs:label "Labor Domain Concept"@en , "مفهوم من مجال العمل"@ar .

:LegalActor rdf:type owl:Class ;
    rdfs:subClassOf :LaborDomainConcept ;
    rdfs:label "Legal Actor"@en , "فاعل قانوني"@ar .

:EmploymentRelation rdf:type owl:Class ;
    rdfs:subClassOf :LaborDomainConcept ;
    rdfs:label "Employment Relation"@en , "علاقة عمل"@ar .

:LegalRight rdf:type owl:Class ;
    rdfs:subClassOf :LaborDomainConcept ;
    rdfs:label "Legal Right"@en , "حق قانوني"@ar .

:LegalObligation rdf:type owl:Class ;
    rdfs:subClassOf :LaborDomainConcept ;
    rdfs:label "Legal Obligation"@en , "التزام قانوني"@ar .

:LegalViolation rdf:type owl:Class ;
    rdfs:subClassOf :LaborDomainConcept ;
    rdfs:label "Legal Violation"@en , "مخالفة قانونية"@ar .

:LegalCondition rdf:type owl:Class ;
    rdfs:subClassOf :LaborDomainConcept ;
    rdfs:label "Legal Condition"@en , "شرط قانوني"@ar .

:LegalConsequence rdf:type owl:Class ;
    rdfs:subClassOf :LaborDomainConcept ;
    rdfs:label "Legal Consequence"@en , "أثر قانوني"@ar .

:LegalEvent rdf:type owl:Class ;
    rdfs:subClassOf :LaborDomainConcept ;
    rdfs:label "Legal Event"@en , "حدث قانوني"@ar .

:Worker rdf:type owl:Class ;
    rdfs:subClassOf :LegalActor ;
    rdfs:label "Worker"@en , "عامل"@ar .

:Employer rdf:type owl:Class ;
    rdfs:subClassOf :LegalActor ;
    rdfs:label "Employer"@en , "صاحب عمل"@ar .

:Establishment rdf:type owl:Class ;
    rdfs:subClassOf :LegalActor ;
    rdfs:label "Establishment"@en , "منشأة"@ar .

:NaturalPerson rdf:type owl:Class ;
    rdfs:subClassOf :LegalActor ;
    rdfs:label "Natural Person"@en , "شخص طبيعي"@ar .

:EmploymentContract rdf:type owl:Class ;
    rdfs:subClassOf :EmploymentRelation ;
    rdfs:label "Employment Contract"@en , "عقد عمل"@ar .

:FixedTermContract rdf:type owl:Class ;
    rdfs:subClassOf :EmploymentContract ;
    rdfs:label "Fixed-Term Contract"@en , "عقد محدد المدة"@ar .

:IndefiniteTermContract rdf:type owl:Class ;
    rdfs:subClassOf :EmploymentContract ;
    rdfs:label "Indefinite-Term Contract"@en , "عقد غير محدد المدة"@ar .

:WrittenContract rdf:type owl:Class ;
    rdfs:subClassOf :EmploymentContract ;
    rdfs:label "Written Contract"@en , "عقد خطي"@ar .

:OralContract rdf:type owl:Class ;
    rdfs:subClassOf :EmploymentContract ;
    rdfs:label "Oral Contract"@en , "عقد شفوي"@ar .

:WageRight rdf:type owl:Class ;
    rdfs:subClassOf :LegalRight ;
    rdfs:label "Wage Right"@en , "حق الأجر"@ar .

:LeaveRight rdf:type owl:Class ;
    rdfs:subClassOf :LegalRight ;
    rdfs:label "Leave Right"@en , "حق الإجازة"@ar .

:SickLeaveRight rdf:type owl:Class ;
    rdfs:subClassOf :LegalRight ;
    rdfs:label "Sick Leave Right"@en , "حق الإجازة المرضية"@ar .

:WeeklyRestRight rdf:type owl:Class ;
    rdfs:subClassOf :LegalRight ;
    rdfs:label "Weekly Rest Right"@en , "حق العطلة الأسبوعية"@ar .

:SafeWorkEnvironmentRight rdf:type owl:Class ;
    rdfs:subClassOf :LegalRight ;
    rdfs:label "Safe Work Environment Right"@en , "حق بيئة العمل الآمنة"@ar .

:LitigationRight rdf:type owl:Class ;
    rdfs:subClassOf :LegalRight ;
    rdfs:label "Litigation Right"@en , "حق التقاضي"@ar .

:SocialSecurityRelatedRight rdf:type owl:Class ;
    rdfs:subClassOf :LegalRight ;
    rdfs:label "Social Security Related Right"@en , "حق متعلق بالضمان الاجتماعي"@ar .

:EndOfServiceBenefitRight rdf:type owl:Class ;
    rdfs:subClassOf :LegalRight ;
    rdfs:label "End of Service Benefit Right"@en , "حق مكافأة نهاية الخدمة"@ar .

:PayWages rdf:type owl:Class ;
    rdfs:subClassOf :LegalObligation ;
    rdfs:label "Pay Wages"@en , "دفع الأجور"@ar .

:ProvideSafeWorkEnvironment rdf:type owl:Class ;
    rdfs:subClassOf :LegalObligation ;
    rdfs:label "Provide Safe Work Environment"@en , "توفير بيئة عمل آمنة"@ar .

:AssignAgreedWork rdf:type owl:Class ;
    rdfs:subClassOf :LegalObligation ;
    rdfs:label "Assign Agreed Work"@en , "إسناد العمل المتفق عليه"@ar .

:PerformWork rdf:type owl:Class ;
    rdfs:subClassOf :LegalObligation ;
    rdfs:label "Perform Work"@en , "أداء العمل"@ar .

:PreserveConfidentiality rdf:type owl:Class ;
    rdfs:subClassOf :LegalObligation ;
    rdfs:label "Preserve Confidentiality"@en , "حفظ السرية"@ar .

:FollowLawfulInstructions rdf:type owl:Class ;
    rdfs:subClassOf :LegalObligation ;
    rdfs:label "Follow Lawful Instructions"@en , "اتباع التعليمات المشروعة"@ar .

:WageDelay rdf:type owl:Class ;
    rdfs:subClassOf :LegalViolation ;
    rdfs:label "Wage Delay"@en , "تأخر دفع الأجور"@ar .

:ArbitraryDismissal rdf:type owl:Class ;
    rdfs:subClassOf :LegalViolation ;
    rdfs:label "Arbitrary Dismissal"@en , "فصل تعسفي"@ar .

:NonProvisionOfAgreedWork rdf:type owl:Class ;
    rdfs:subClassOf :LegalViolation ;
    rdfs:label "Non-Provision of Agreed Work"@en , "عدم توفير العمل المتفق عليه"@ar .

:AssignmentOfDifferentWork rdf:type owl:Class ;
    rdfs:subClassOf :LegalViolation ;
    rdfs:label "Assignment of Different Work"@en , "تكليف بعمل مختلف"@ar .

:DisclosureOfEmployerSecrets rdf:type owl:Class ;
    rdfs:subClassOf :LegalViolation ;
    rdfs:label "Disclosure of Employer Secrets"@en , "إفشاء أسرار صاحب العمل"@ar .

:WorkNegligence rdf:type owl:Class ;
    rdfs:subClassOf :LegalViolation ;
    rdfs:label "Work Negligence"@en , "إهمال في العمل"@ar .

:DelayExceedsSevenDays rdf:type owl:Class ;
    rdfs:subClassOf :LegalCondition ;
    rdfs:label "Delay Exceeds Seven Days"@en , "تجاوز التأخير سبعة أيام"@ar .

:WorkerNotCoveredBySocialSecurity rdf:type owl:Class ;
    rdfs:subClassOf :LegalCondition ;
    rdfs:label "Worker Not Covered by Social Security"@en , "عامل غير مشمول بالضمان الاجتماعي"@ar .

:DismissalWithoutLawfulGround rdf:type owl:Class ;
    rdfs:subClassOf :LegalCondition ;
    rdfs:label "Dismissal Without Lawful Ground"@en , "فصل دون سبب مشروع"@ar .

:ContractIsFixedTerm rdf:type owl:Class ;
    rdfs:subClassOf :LegalCondition ;
    rdfs:label "Contract Is Fixed Term"@en , "العقد محدد المدة"@ar .

:ContractIsIndefiniteTerm rdf:type owl:Class ;
    rdfs:subClassOf :LegalCondition ;
    rdfs:label "Contract Is Indefinite Term"@en , "العقد غير محدد المدة"@ar .

:Compensation rdf:type owl:Class ;
    rdfs:subClassOf :LegalConsequence ;
    rdfs:label "Compensation"@en , "تعويض"@ar .

:LegalClaim rdf:type owl:Class ;
    rdfs:subClassOf :LegalConsequence ;
    rdfs:label "Legal Claim"@en , "مطالبة قانونية"@ar .

:TerminationOfContract rdf:type owl:Class ;
    rdfs:subClassOf :LegalConsequence ;
    rdfs:label "Termination of Contract"@en , "إنهاء العقد"@ar .

:EndOfServiceBenefit rdf:type owl:Class ;
    rdfs:subClassOf :LegalConsequence ;
    rdfs:label "End of Service Benefit"@en , "مكافأة نهاية الخدمة"@ar .

:EmployerLiability rdf:type owl:Class ;
    rdfs:subClassOf :LegalConsequence ;
    rdfs:label "Employer Liability"@en , "مسؤولية صاحب العمل"@ar .

:DisciplinaryAction rdf:type owl:Class ;
    rdfs:subClassOf :LegalConsequence ;
    rdfs:label "Disciplinary Action"@en , "إجراء تأديبي"@ar .

:ContractFormation rdf:type owl:Class ;
    rdfs:subClassOf :LegalEvent ;
    rdfs:label "Contract Formation"@en , "إبرام العقد"@ar .

:WagePayment rdf:type owl:Class ;
    rdfs:subClassOf :LegalEvent ;
    rdfs:label "Wage Payment"@en , "دفع الأجر"@ar .

:Dismissal rdf:type owl:Class ;
    rdfs:subClassOf :LegalEvent ;
    rdfs:label "Dismissal"@en , "فصل"@ar .

:LeaveRequest rdf:type owl:Class ;
    rdfs:subClassOf :LegalEvent ;
    rdfs:label "Leave Request"@en , "طلب إجازة"@ar .

:MedicalExamination rdf:type owl:Class ;
    rdfs:subClassOf :LegalEvent ;
    rdfs:label "Medical Examination"@en , "فحص طبي"@ar .

:WorkInjury rdf:type owl:Class ;
    rdfs:subClassOf :LegalEvent ;
    rdfs:label "Work Injury"@en , "إصابة عمل"@ar .

########## Object Properties ##########

:hasArticle rdf:type owl:ObjectProperty ;
    rdfs:domain :Law ;
    rdfs:range :Article ;
    rdfs:label "has article"@en , "له مادة"@ar .

:hasParagraph rdf:type owl:ObjectProperty ;
    rdfs:domain :Article ;
    rdfs:range :Paragraph ;
    rdfs:label "has paragraph"@en , "له فقرة"@ar .

:hasDefinition rdf:type owl:ObjectProperty ;
    rdfs:domain :Article ;
    rdfs:range :Definition ;
    rdfs:label "has definition"@en , "له تعريف"@ar .

:amendedBy rdf:type owl:ObjectProperty ;
    rdfs:domain :Law ;
    rdfs:range :Amendment ;
    rdfs:label "amended by"@en , "معدل بموجب"@ar .

:defines rdf:type owl:ObjectProperty ;
    rdfs:domain :Definition ;
    rdfs:range :LaborDomainConcept ;
    rdfs:label "defines"@en , "يعرّف"@ar .

:regulates rdf:type owl:ObjectProperty ;
    rdfs:domain :Article ;
    rdfs:range :LaborDomainConcept ;
    rdfs:label "regulates"@en , "ينظم"@ar .

:isPartyTo rdf:type owl:ObjectProperty ;
    rdfs:domain :LegalActor ;
    rdfs:range :EmploymentContract ;
    rdfs:label "is party to"@en , "طرف في"@ar .

:hasEmployer rdf:type owl:ObjectProperty ;
    rdfs:domain :EmploymentContract ;
    rdfs:range :Employer ;
    rdfs:label "has employer"@en , "له صاحب عمل"@ar .

:hasWorker rdf:type owl:ObjectProperty ;
    rdfs:domain :EmploymentContract ;
    rdfs:range :Worker ;
    rdfs:label "has worker"@en , "له عامل"@ar .

:hasRight rdf:type owl:ObjectProperty ;
    rdfs:domain :LegalActor ;
    rdfs:range :LegalRight ;
    rdfs:label "has right"@en , "له حق"@ar .

:hasObligation rdf:type owl:ObjectProperty ;
    rdfs:domain :LegalActor ;
    rdfs:range :LegalObligation ;
    rdfs:label "has obligation"@en , "عليه التزام"@ar .

:breachesObligation rdf:type owl:ObjectProperty ;
    rdfs:domain :LegalViolation ;
    rdfs:range :LegalObligation ;
    rdfs:label "breaches obligation"@en , "يخرق التزامًا"@ar .

:violatesRight rdf:type owl:ObjectProperty ;
    rdfs:domain :LegalViolation ;
    rdfs:range :LegalRight ;
    rdfs:label "violates right"@en , "ينتهك حقًا"@ar .

:committedBy rdf:type owl:ObjectProperty ;
    rdfs:domain :LegalViolation ;
    rdfs:range :LegalActor ;
    rdfs:label "committed by"@en , "مرتكب من قبل"@ar .

:sufferedBy rdf:type owl:ObjectProperty ;
    rdfs:domain :LegalViolation ;
    rdfs:range :LegalActor ;
    rdfs:label "suffered by"@en , "متضرر منه"@ar .

:hasCondition rdf:type owl:ObjectProperty ;
    rdfs:domain :LegalViolation ;
    rdfs:range :LegalCondition ;
    rdfs:label "has condition"@en , "له شرط"@ar .

:resultsIn rdf:type owl:ObjectProperty ;
    rdfs:domain :LaborDomainConcept ;
    rdfs:range :LegalConsequence ;
    rdfs:label "results in"@en , "يترتب عليه"@ar .

:basedOnEvent rdf:type owl:ObjectProperty ;
    rdfs:domain :LegalViolation ;
    rdfs:range :LegalEvent ;
    rdfs:label "based on event"@en , "مبني على حدث"@ar .

:definedIn rdf:type owl:ObjectProperty ;
    rdfs:domain :LaborDomainConcept ;
    rdfs:range :Definition ;
    rdfs:label "defined in"@en , "معرّف في"@ar .

:regulatedBy rdf:type owl:ObjectProperty ;
    rdfs:domain :LaborDomainConcept ;
    rdfs:range :Article ;
    rdfs:label "regulated by"@en , "منظم بموجب"@ar .

:supportedByArticle rdf:type owl:ObjectProperty ;
    rdfs:domain :LaborDomainConcept ;
    rdfs:range :Article ;
    rdfs:label "supported by article"@en , "مدعوم بالمادة"@ar .

