########## FINAL GRAPHRAG SEMANTIC COVERAGE LAYER ##########
# Semantic concepts added systematically for graph-only legal-evidence retrieval.
# Article and Paragraph nodes remain legal-source nodes and are never semantic-search seeds.

:LegalConcept rdf:type owl:Class ;
    rdfs:label "Legal Concept"@en , "مفهوم قانوني"@ar .

:StatutoryConcept rdf:type owl:Class ;
    rdfs:subClassOf :LegalConcept ;
    rdfs:label "Statutory Concept"@en , "مفهوم تشريعي"@ar .

:LaborDomainConcept rdfs:subClassOf :LegalConcept .

:law_identity_concept rdf:type :StatutoryConcept ;
    rdfs:label "هوية قانون العمل"@ar ;
    skos:altLabel "اسم قانون العمل"@ar ;
    skos:altLabel "تسمية قانون العمل"@ar ;
    skos:altLabel "قانون العمل لسنة 1996"@ar ;
    :supportedByArticle :article_1 .

:law_commencement_concept rdf:type :StatutoryConcept ;
    rdfs:label "نفاذ قانون العمل"@ar ;
    skos:altLabel "سريان القانون"@ar ;
    skos:altLabel "بدء العمل بالقانون"@ar ;
    skos:altLabel "تاريخ نفاذ القانون"@ar ;
    skos:altLabel "النشر في الجريدة الرسمية"@ar ;
    :supportedByArticle :article_1 .

:labor_law_scope_concept rdf:type :StatutoryConcept ;
    rdfs:label "نطاق تطبيق قانون العمل"@ar ;
    skos:altLabel "سريان قانون العمل على العمال وأصحاب العمل"@ar ;
    skos:altLabel "الاستثناءات من تطبيق قانون العمل"@ar ;
    :supportedByArticle :article_3 .

:worker_favorable_rights_nonwaiver_concept rdf:type :StatutoryConcept ;
    rdfs:label "حماية الحقوق الأفضل وعدم التنازل عنها"@ar ;
    skos:altLabel "الحقوق الأفضل للعامل"@ar ;
    skos:altLabel "بطلان التنازل عن حقوق العامل"@ar ;
    skos:altLabel "عدم الانتقاص من حقوق العامل"@ar ;
    :supportedByArticle :article_4 .

:labor_inspection_ministry_role_concept rdf:type :StatutoryConcept ;
    rdfs:label "اختصاص الوزارة بالتفتيش العمالي"@ar ;
    skos:altLabel "مهام التفتيش"@ar ;
    skos:altLabel "تفتيش العمل"@ar ;
    skos:altLabel "الوزارة والتفتيش"@ar ;
    :supportedByArticle :article_5 .

:labor_inspector_confidentiality_concept rdf:type :StatutoryConcept ;
    rdfs:label "سرية وأمانة مفتش العمل"@ar ;
    skos:altLabel "قسم مفتش العمل"@ar ;
    skos:altLabel "عدم إفشاء أسرار العمل"@ar ;
    skos:altLabel "التزام مفتش العمل بالسرية"@ar ;
    :supportedByArticle :article_6 .

:labor_inspector_qualifications_powers_concept rdf:type :StatutoryConcept ;
    rdfs:label "مؤهلات وصلاحيات مفتشي العمل"@ar ;
    skos:altLabel "مهام مفتشي العمل"@ar ;
    skos:altLabel "مكافآت مفتشي العمل"@ar ;
    skos:altLabel "التزامات صاحب العمل تجاه المفتش"@ar ;
    :supportedByArticle :article_7 .

:employer_inspection_records_notice_concept rdf:type :StatutoryConcept ;
    rdfs:label "إشعارات وسجلات صاحب العمل للتفتيش"@ar ;
    skos:altLabel "بيان العمال للوزارة"@ar ;
    skos:altLabel "سجلات العمال والمتدربين"@ar ;
    skos:altLabel "إشعار الوزارة بالعمال"@ar ;
    :supportedByArticle :article_8 .

:labor_inspector_enforcement_concept rdf:type :StatutoryConcept ;
    rdfs:label "صلاحيات مفتش العمل في إزالة المخالفات"@ar ;
    skos:altLabel "الضابطة العدلية لمفتش العمل"@ar ;
    skos:altLabel "إنذار إزالة المخالفة"@ar ;
    skos:altLabel "إغلاق المؤسسة بسبب المخالفة"@ar ;
    skos:altLabel "غرامة مخالفة التفتيش"@ar ;
    :supportedByArticle :article_9 .

:labor_market_employment_services_concept rdf:type :StatutoryConcept ;
    rdfs:label "تنظيم سوق العمل ومكاتب التشغيل"@ar ;
    skos:altLabel "التوجيه المهني"@ar ;
    skos:altLabel "توفير فرص العمل"@ar ;
    skos:altLabel "مكاتب تشغيل الأردنيين"@ar ;
