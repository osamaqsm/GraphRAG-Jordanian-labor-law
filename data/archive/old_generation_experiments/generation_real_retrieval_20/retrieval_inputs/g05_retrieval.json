          ],
          "labels_en": [],
          "article_number": null,
          "text_preview": "اذا استمر العامل في عمله بعد انتهاء مدة التجربة اعتبر العقد عقد عمل ولمدة غير محدودة وتحسب مدة التجربة ضمن مدة خدمة العامل لدى صاحب العمل.",
          "vector_rank": 37,
