########## Canonical Domain Concept Individuals ##########

:worker_concept rdf:type :Worker ;
    rdfs:label "العامل"@ar .

:employer_concept rdf:type :Employer ;
    rdfs:label "صاحب العمل"@ar .

:establishment_concept rdf:type :Establishment ;
    rdfs:label "المؤسسة"@ar .

:employment_contract_concept rdf:type :EmploymentContract ;
    rdfs:label "عقد العمل"@ar .

:fixed_term_contract_concept rdf:type :FixedTermContract ;
    rdfs:label "عقد العمل محدد المدة"@ar .

:indefinite_term_contract_concept rdf:type :IndefiniteTermContract ;
    rdfs:label "عقد العمل غير محدد المدة"@ar .

:written_contract_concept rdf:type :WrittenContract ;
    rdfs:label "عقد العمل الخطي"@ar .

:oral_contract_concept rdf:type :OralContract ;
    rdfs:label "عقد العمل الشفهي"@ar .

:wage_right_concept rdf:type :WageRight ;
    rdfs:label "حق الأجر"@ar .

:leave_right_concept rdf:type :LeaveRight ;
    rdfs:label "حق الإجازة"@ar .

:sick_leave_right_concept rdf:type :SickLeaveRight ;
    rdfs:label "حق الإجازة المرضية"@ar .

:weekly_rest_right_concept rdf:type :WeeklyRestRight ;
    rdfs:label "حق العطلة الأسبوعية"@ar .

:safe_work_environment_right_concept rdf:type :SafeWorkEnvironmentRight ;
    rdfs:label "حق بيئة العمل الآمنة"@ar .

:litigation_right_concept rdf:type :LitigationRight ;
    rdfs:label "حق التقاضي"@ar .

:social_security_related_right_concept rdf:type :SocialSecurityRelatedRight ;
    rdfs:label "حق متعلق بالضمان الاجتماعي"@ar .

:end_of_service_benefit_right_concept rdf:type :EndOfServiceBenefitRight ;
    rdfs:label "حق مكافأة نهاية الخدمة"@ar .

:pay_wages_obligation rdf:type :PayWages ;
    rdfs:label "التزام دفع الأجور"@ar .

:provide_safe_work_environment_obligation rdf:type :ProvideSafeWorkEnvironment ;
    rdfs:label "التزام توفير بيئة عمل آمنة"@ar .

:assign_agreed_work_obligation rdf:type :AssignAgreedWork ;
    rdfs:label "التزام إسناد العمل المتفق عليه"@ar .

:perform_work_obligation rdf:type :PerformWork ;
    rdfs:label "التزام أداء العمل"@ar .

:preserve_confidentiality_obligation rdf:type :PreserveConfidentiality ;
    rdfs:label "التزام حفظ السرية"@ar .

:follow_lawful_instructions_obligation rdf:type :FollowLawfulInstructions ;
    rdfs:label "التزام اتباع التعليمات المشروعة"@ar .

:wage_delay_violation rdf:type :WageDelay ;
    rdfs:label "مخالفة تأخر دفع الأجور"@ar .

