# ============================================================
# Jordan Legal KG - final ontology-driven GraphRAG configuration
# Only PIPELINE_LLM_PROVIDER and PIPELINE_LLM_MODEL change across
# evaluated-model runs. Keep all retrieval/embedding settings frozen.
# ============================================================

APP_NAME=Jordan Legal KG API
APP_VERSION=1.0.0-graphrag
APP_ENVIRONMENT=development

# Evaluated LLM
PIPELINE_LLM_PROVIDER=openai
PIPELINE_LLM_MODEL=gpt-5-nano

# Fixed LLM budgets
PLANNER_MAX_OUTPUT_TOKENS=3000
RERANKER_MAX_OUTPUT_TOKENS=2000
GENERATOR_MAX_OUTPUT_TOKENS=3000

# Planner policy
PLANNER_VERIFY_ABSTAIN=true
PLANNER_ABSTAIN_VERIFY_CONFIDENCE=0.80

# OpenAI: required for fixed embeddings and the fixed judge.
OPENAI_API_KEY=REPLACE_ME
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TIMEOUT_SECONDS=120
OPENAI_MAX_RETRIES=3
EMBEDDING_BATCH_SIZE=32

# Optional evaluated-model providers
ANTHROPIC_API_KEY=
ANTHROPIC_TIMEOUT_SECONDS=120
ANTHROPIC_MAX_RETRIES=3

GOOGLE_API_KEY=
GOOGLE_TIMEOUT_SECONDS=120

OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://opencode.ai/zen/go
OPENCODE_TIMEOUT_SECONDS=120

COHERE_API_KEY=
COHERE_BASE_URL=https://api.cohere.com
COHERE_TIMEOUT_SECONDS=120

OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_TIMEOUT_SECONDS=600
OLLAMA_NUM_CTX=8192

# Reranker input budget
RERANKER_CANDIDATE_LIMIT=12
RERANKER_TOTAL_CHAR_BUDGET=12000
RERANKER_ARTICLE_CHAR_LIMIT=2500

# Weaviate
WEAVIATE_API_KEY=REPLACE_WITH_A_LONG_RANDOM_KEY
WEAVIATE_HTTP_HOST=weaviate
WEAVIATE_HTTP_PORT=8080
WEAVIATE_GRPC_HOST=weaviate
WEAVIATE_GRPC_PORT=50051
WEAVIATE_CONNECTION_ATTEMPTS=30
WEAVIATE_CONNECTION_DELAY_SECONDS=2
WEAVIATE_NODE_COLLECTION=JordanLaborLegalNode
WEAVIATE_EDGE_COLLECTION=JordanLaborLegalEdge
WEAVIATE_NODE_BATCH_SIZE=25
WEAVIATE_EDGE_BATCH_SIZE=100

# Concept linking (concept nodes only; never Article/Paragraph nodes)
CONCEPT_VECTOR_CANDIDATES=40
CONCEPT_BM25_CANDIDATES=40
CONCEPT_TOP_K=16
CONCEPT_RRF_K=60
CONCEPT_SEMANTIC_WEIGHT=0.35
CONCEPT_LEXICAL_WEIGHT=0.25
CONCEPT_HINT_WEIGHT=0.25
CONCEPT_SPECIFICITY_WEIGHT=0.15

# Graph seed selection
GRAPH_SEED_COUNT=4
GRAPH_SEED_MIN_SCORE=0.28
GRAPH_SEED_RELATIVE_THRESHOLD=0.70

# Relation-aware graph traversal
GRAPH_MAX_HOPS=2
GRAPH_EDGES_LIMIT=1500
GRAPH_PATHS_PER_ARTICLE=5
GRAPH_HOP_DECAY=0.72

# Graph-derived article ranking
ISSUE_ARTICLE_CANDIDATES=8
ARTICLE_TOP_K=5
ARTICLE_GRAPH_WEIGHT=0.75
ARTICLE_ISSUE_RELEVANCE_WEIGHT=0.25

# Fixed evaluation judge
EVALUATION_JUDGE_MODEL=gpt-5.4-mini

KG_TTL_PATH=/app/data/jordan_labor_law_full_knowledge_graph.ttl
